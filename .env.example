# Copy to `.env` and fill in. `.env` is gitignored.
# Load it in code via os.environ, or with `python-dotenv` if you add it.

# Example runtime setting:
# MYTOOL_LOG_LEVEL=INFO

# PyPI upload (only needed if NOT using the trusted-publishing GitHub Action).
# Prefer the OIDC flow in .github/workflows/publish.yml over storing a token.
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-...
